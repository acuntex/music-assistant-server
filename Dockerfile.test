# Fork-only test image: the official image plus only the patched files.
#
# Building the full image from a fork loses helpers/app_secrets.json (injected from
# a private repo at release time), which empties the Spotify/Tidal/Qobuz/LastFM
# app keys. Overlaying keeps every bit of the official image intact and replaces
# only what the prototype touches.
ARG BASE_IMAGE=ghcr.io/music-assistant/server:2.11.0.dev2026111203
FROM ${BASE_IMAGE}

USER root

COPY music_assistant/controllers/streams/ /app/venv/lib/python3.14/site-packages/music_assistant/controllers/streams/
COPY music_assistant/providers/ai_radio/ /app/venv/lib/python3.14/site-packages/music_assistant/providers/ai_radio/


USER 1000:1001
